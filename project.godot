; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="小车遥控"
run/main_scene="uid://djeb0cuoeaeet"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/stretch_mode=3
config/icon="uid://doggpirofqfh8"

[autoload]

AppState="*res://state/AppState.gd"
AnimationManager="*res://animation/AnimationManager.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=3200
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="新建游戏项目"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdble_export/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
